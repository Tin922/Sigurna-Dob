@inherits LayoutComponentBase
@using SigurnaDob.App.Theme

<MudThemeProvider Theme="SigurnaDobTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="sigurna-layout">
    <MudAppBar Elevation="0" Class="sigurna-appbar" Dense="true">
        <MudIcon Icon="@Icons.Material.Outlined.ElderlyWoman" Class="sigurna-appbar-logo mr-2" />
        <MudText Typo="Typo.h6" Class="sigurna-appbar-title">Sigurna dob</MudText>
        <MudSpacer />
        <MudText Typo="Typo.caption" Class="sigurna-appbar-subtitle d-none d-sm-block">
            Dom za starije osobe
        </MudText>
    </MudAppBar>

    <MudDrawer Open="true"
               Elevation="0"
               Variant="DrawerVariant.Responsive"
               ClipMode="DrawerClipMode.Always"
               Class="sigurna-drawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="sigurna-main">
        <div class="sigurna-content">
            @Body
        </div>
    </MudMainContent>
</MudLayout>
