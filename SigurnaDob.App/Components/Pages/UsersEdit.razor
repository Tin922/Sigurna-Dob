@page "/users/edit/{Id:int}"
@rendermode InteractiveServer

@using SigurnaDob.App.Services
@using SigurnaDob.Shared.Constants
@using SigurnaDob.Shared.Dtos

@inject HttpClient Http
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>Uredi korisnički račun</PageTitle>

<div class="page-header">
    <MudText Typo="Typo.h4" Class="page-title">Uredi korisnički račun</MudText>
    @if (!string.IsNullOrWhiteSpace(currentEmail))
    {
        <MudText Typo="Typo.body2" Class="page-subtitle">@currentEmail</MudText>
    }
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <MudAlert Severity="Severity.Success" Class="mb-4">@successMessage</MudAlert>
}

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudStack Spacing="2" Style="max-width: 560px">
        <MudTextField @bind-Value="model.Email" Label="Email" Required="true" Variant="Variant.Outlined" />
        <MudTextField @bind-Value="model.DisplayName" Label="Prikazano ime" Required="true" Variant="Variant.Outlined" />
        <MudTextField @bind-Value="model.Password"
                      Label="Nova lozinka"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      HelperText="Ostavite prazno ako ne mijenjate lozinku" />

        <MudSelect T="int"
                   Label="Uloge"
                   MultiSelection="true"
                   @bind-SelectedValues="selectedRoleIds"
                   Variant="Variant.Outlined"
                   Required="true">
            @foreach (var role in roles)
            {
                <MudSelectItem Value="@role.Id">@role.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="string"
                   Label="Poveznica profila"
                   @bind-Value="profileLinkType"
                   Variant="Variant.Outlined">
            <MudSelectItem Value="@ProfileLinkNone">Bez poveznice</MudSelectItem>
            <MudSelectItem Value="@ProfileLinkEmployee">Djelatnik</MudSelectItem>
            <MudSelectItem Value="@ProfileLinkFamily">Obiteljski kontakt</MudSelectItem>
        </MudSelect>

        @if (profileLinkType == ProfileLinkEmployee)
        {
            <MudSelect T="int?"
                       Label="Djelatnik"
                       @bind-Value="model.EmployeeId"
                       Variant="Variant.Outlined"
                       Clearable="true">
                @foreach (var employee in employees)
                {
                    <MudSelectItem T="int?" Value="@((int?)employee.Id)">@employee.Name</MudSelectItem>
                }
            </MudSelect>
        }
        else if (profileLinkType == ProfileLinkFamily)
        {
            <MudSelect T="int?"
                       Label="Obiteljski kontakt"
                       @bind-Value="model.FamilyContactId"
                       Variant="Variant.Outlined"
                       Clearable="true">
                @foreach (var contact in familyContacts)
                {
                    <MudSelectItem T="int?" Value="@((int?)contact.Id)">@contact.Name</MudSelectItem>
                }
            </MudSelect>
        }

        <MudSwitch @bind-Value="model.IsActive"
                   Label="Račun aktivan"
                   Color="Color.Primary"
                   Disabled="@(Id == CurrentUser.User?.Id)" />

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="isSaving">
                @(isSaving ? "Spremanje..." : "Spremi promjene")
            </MudButton>
            <MudButton Variant="Variant.Outlined" Href="/users">Natrag</MudButton>
        </MudStack>
    </MudStack>
}

@code {
    [Parameter] public int Id { get; set; }

    private const string ProfileLinkNone = "none";
    private const string ProfileLinkEmployee = "employee";
    private const string ProfileLinkFamily = "family";

    private SaveAppUserDto model = new();
    private IReadOnlyCollection<int> selectedRoleIds = Array.Empty<int>();
    private List<LookupDto> roles = new();
    private List<LookupDto> employees = new();
    private List<LookupDto> familyContacts = new();
    private string profileLinkType = ProfileLinkNone;
    private string? currentEmail;
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;
    private string? successMessage;
    private bool authReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || authReady)
            return;

        if (!await PageAuth.EnsureLoggedInAsync(CurrentUser, Navigation))
            return;

        if (!CurrentUser.HasAnyRole(AppRoles.Admin))
        {
            Navigation.NavigateTo("/users");
            return;
        }

        authReady = true;
        await LoadLookups();
        await LoadUser();
        StateHasChanged();
    }

    private async Task LoadLookups()
    {
        roles = await Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/app-roles") ?? new();
        employees = await Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/employees") ?? new();
        familyContacts = await Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/family-contacts") ?? new();
    }

    private async Task LoadUser()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var detail = await Http.GetFromJsonAsync<AppUserDetailDto>($"api/users/{Id}");
            if (detail is null)
            {
                errorMessage = "Račun nije pronađen.";
                return;
            }

            currentEmail = detail.Email;
            model = new SaveAppUserDto
            {
                Email = detail.Email,
                DisplayName = detail.DisplayName,
                IsActive = detail.IsActive,
                EmployeeId = detail.EmployeeId,
                FamilyContactId = detail.FamilyContactId
            };
            selectedRoleIds = detail.RoleIds.ToHashSet();

            profileLinkType = detail.EmployeeId.HasValue
                ? ProfileLinkEmployee
                : detail.FamilyContactId.HasValue
                    ? ProfileLinkFamily
                    : ProfileLinkNone;
        }
        catch (Exception ex)
        {
            errorMessage = $"Račun nije moguće učitati: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Save()
    {
        errorMessage = null;
        successMessage = null;
        ApplyProfileLink();
        model.RoleIds = selectedRoleIds.Distinct().ToList();
        isSaving = true;

        try
        {
            var response = await Http.PutAsJsonAsync($"api/users/{Id}", model);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            successMessage = "Promjene su spremljene.";
            await LoadUser();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ApplyProfileLink()
    {
        model.EmployeeId = profileLinkType == ProfileLinkEmployee ? model.EmployeeId : null;
        model.FamilyContactId = profileLinkType == ProfileLinkFamily ? model.FamilyContactId : null;
    }
}
