@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">@TaskTitle</MudText>
        <MudTextField @bind-Value="completionNote"
                      @bind-Value:after="OnNoteChanged"
                      Label="Bilješka završetka"
                      Lines="4"
                      Required="true"
                      Immediate="true"
                      Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Odustani</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="@(!CanSubmit)">
            Spremi
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string TaskTitle { get; set; } = string.Empty;

    private string completionNote = string.Empty;

    private bool CanSubmit => !string.IsNullOrWhiteSpace(completionNote);

    private void OnNoteChanged() => StateHasChanged();

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (!CanSubmit)
            return;

        MudDialog.Close(DialogResult.Ok(completionNote.Trim()));
    }
}
