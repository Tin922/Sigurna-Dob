@page "/rooms/edit/{Id:int}"
@rendermode InteractiveServer

@using SigurnaDob.App.Services
@using SigurnaDob.Shared.Constants
@using SigurnaDob.Shared.Dtos

@inject HttpClient Http
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>Uredi sobu</PageTitle>

<div class="page-header">
    <MudText Typo="Typo.h4" Class="page-title">Uredi sobu</MudText>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
}

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudStack Spacing="2" Style="max-width: 460px">
        <MudText Typo="Typo.body2" Class="mb-2">
            Popunjeno: @occupancy / @model.Capacity
        </MudText>

        <MudTextField @bind-Value="model.Name" Label="Naziv" Required="true" Variant="Variant.Outlined" />
        <MudNumericField @bind-Value="model.Capacity" Label="Kapacitet" Min="1" Variant="Variant.Outlined" />

        <MudSelect T="int"
                   Label="Status"
                   @bind-Value="model.RoomStatusId"
                   Variant="Variant.Outlined"
                   Required="true">
            @foreach (var status in statuses)
            {
                <MudSelectItem Value="@status.Id">@status.Name</MudSelectItem>
            }
        </MudSelect>

        <MudTextField @bind-Value="model.Note" Label="Bilješka" Lines="2" Variant="Variant.Outlined" />

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="isSaving">
                @(isSaving ? "Spremanje..." : "Spremi promjene")
            </MudButton>
            <MudButton Variant="Variant.Outlined" Href="/rooms">Odustani</MudButton>
        </MudStack>
    </MudStack>
}

@code {
    [Parameter] public int Id { get; set; }

    private SaveRoomDto model = new();
    private List<LookupDto> statuses = new();
    private int occupancy;
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;
    private bool authReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || authReady)
            return;

        if (!await PageAuth.EnsureLoggedInAsync(CurrentUser, Navigation))
            return;

        if (!CurrentUser.HasAnyRole(AppRoles.Admin, AppRoles.Coordinator))
        {
            Navigation.NavigateTo("/rooms");
            return;
        }

        authReady = true;
        await LoadRoom();
        StateHasChanged();
    }

    private async Task LoadRoom()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            statuses = await Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/room-statuses") ?? new();
            var room = await Http.GetFromJsonAsync<RoomDetailDto>($"api/rooms/{Id}");

            if (room is null)
            {
                errorMessage = "Soba nije pronađena.";
                return;
            }

            model = new SaveRoomDto
            {
                Name = room.Name,
                Capacity = room.Capacity,
                RoomStatusId = room.RoomStatusId,
                Note = room.Note
            };
            occupancy = room.Occupancy;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Save()
    {
        errorMessage = null;
        isSaving = true;

        try
        {
            var response = await Http.PutAsJsonAsync($"api/rooms/{Id}", model);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(errorMessage))
                    errorMessage = "Spremanje nije uspjelo.";
                return;
            }

            Navigation.NavigateTo("/rooms");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
