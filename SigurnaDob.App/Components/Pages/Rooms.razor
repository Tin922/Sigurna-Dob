@page "/rooms"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.WebUtilities
@using SigurnaDob.App.Services
@using SigurnaDob.Shared.Constants
@using SigurnaDob.Shared.Dtos

@inject HttpClient Http
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>Sobe</PageTitle>

<div class="page-header">
    <MudText Typo="Typo.h4" Class="page-title">Sobe</MudText>
    <MudText Typo="Typo.body2" Class="page-subtitle">Kapacitet, popunjenost i status soba</MudText>
</div>

@if (CurrentUser.HasAnyRole(AppRoles.Admin, AppRoles.Coordinator))
{
    <MudButton Variant="Variant.Filled"
               Color="Color.Secondary"
               Href="/rooms/create"
               Class="mb-4"
               StartIcon="@Icons.Material.Filled.Add">
        Nova soba
    </MudButton>
}

<MudPaper Class="pa-4 filter-panel" Elevation="0">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="search"
                          Label="Pretraži"
                          Placeholder="Naziv sobe"
                          Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect T="int?"
                       Label="Status"
                       @bind-Value="statusId"
                       Variant="Variant.Outlined"
                       Clearable="true">
                @foreach (var status in statuses)
                {
                    <MudSelectItem T="int?" Value="@((int?)status.Id)">@status.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadRooms">
                Primijeni
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ResetFilters">
                Očisti
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
}

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTable Items="rooms" Hover="true" Dense="true" Class="content-card mt-4" Elevation="0">
        <HeaderContent>
            <MudTh>Naziv</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Kapacitet</MudTh>
            <MudTh>Popunjeno</MudTh>
            <MudTh>Slobodno</MudTh>
            <MudTh>Akcije</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.StatusName</MudTd>
            <MudTd>@context.Capacity</MudTd>
            <MudTd>@context.Occupancy</MudTd>
            <MudTd>@context.AvailableSpots</MudTd>
            <MudTd>
                @if (CurrentUser.HasAnyRole(AppRoles.Admin, AppRoles.Coordinator))
                {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               Href="@($"/rooms/edit/{context.Id}")">
                        Uredi
                    </MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4">Nema soba za zadane filtere.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private List<RoomDto> rooms = new();
    private List<LookupDto> statuses = new();
    private string? search;
    private int? statusId;
    private bool isLoading = true;
    private string? errorMessage;
    private bool authReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || authReady)
            return;

        if (!await PageAuth.EnsureLoggedInAsync(CurrentUser, Navigation))
            return;

        if (!CurrentUser.HasAnyRole(AppRoles.Admin, AppRoles.Coordinator, AppRoles.Caregiver))
        {
            Navigation.NavigateTo("/");
            return;
        }

        authReady = true;
        statuses = await Http.GetFromJsonAsync<List<LookupDto>>("api/lookups/room-statuses") ?? new();
        await LoadRooms();
        StateHasChanged();
    }

    private async Task LoadRooms()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var query = new Dictionary<string, string?>();
            if (!string.IsNullOrWhiteSpace(search))
                query["search"] = search.Trim();
            if (statusId.HasValue)
                query["statusId"] = statusId.Value.ToString();

            var url = QueryHelpers.AddQueryString("api/rooms", query);
            rooms = await Http.GetFromJsonAsync<List<RoomDto>>(url) ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Sobe nije moguće učitati: {ex.Message}";
            rooms = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ResetFilters()
    {
        search = null;
        statusId = null;
        await LoadRooms();
    }
}
